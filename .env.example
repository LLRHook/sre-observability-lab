# Copy to .env (gitignored). Lab defaults; nothing here is a real secret.

# Unlocks ticketing-api's /admin/chaos* endpoints. ops-copilot gets the same token
# and nothing else: it is the only privilege the copilot holds.
ADMIN_TOKEN=lab-admin-token-change-me

# Grafana admin login (anonymous viewer access is on regardless).
GRAFANA_ADMIN_PASSWORD=admin

# Synthetic traffic rate.
LOADGEN_RATE=10

# Optional. When set, ops-copilot summarises with Claude; when empty it uses the
# deterministic rules engine. The lab works fully offline.
ANTHROPIC_API_KEY=
COPILOT_MODEL=claude-opus-5-5
