{
  "policy": {
    "description": "srelab log retention: keep daily log indices for 3 days, then delete",
    "default_state": "hot",
    "states": [
      {
        "name": "hot",
        "actions": [],
        "transitions": [
          {
            "state_name": "delete",
            "conditions": {"min_index_age": "3d"}
          }
        ]
      },
      {
        "name": "delete",
        "actions": [{"delete": {}}],
        "transitions": []
      }
    ],
    "ism_template": [
      {"index_patterns": ["srelab-logs-*"], "priority": 100}
    ]
  }
}
